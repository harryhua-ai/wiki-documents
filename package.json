{
  "name": "classic",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build && npm run build:check-ingest",
    "build:check-ingest": "node scripts/check-docs-changed.js || cd api && npm run ingest",
    "build:force-index": "docusaurus build && cd api && npm run ingest:force",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "cd api && npm run ingest && cd .. && docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "test:e2e": "playwright test",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "ingest": "cd api && npm run ingest",
    "ingest:force": "cd api && npm run ingest:force",
    "api:dev": "cd api && npm run dev",
    "api:build": "cd api && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.6.1",
    "@docusaurus/plugin-client-redirects": "3.6.1",
    "@docusaurus/plugin-google-tag-manager": "3.6.1",
    "@docusaurus/plugin-sitemap": "3.6.1",
    "@docusaurus/preset-classic": "3.6.1",
    "@docusaurus/theme-mermaid": "3.6.1",
    "@easyops-cn/docusaurus-search-local": "^0.49.2",
    "@mdx-js/react": "^3.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.0.0",
    "docusaurus": "^1.14.7",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "intersection-observer": "^0.12.2",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resize-observer-polyfill": "^1.5.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.6.1",
    "@docusaurus/types": "3.6.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.6.1",
    "jsdom": "^28.0.0",
    "vitest": "^4.0.18"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
