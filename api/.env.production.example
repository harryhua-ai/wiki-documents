# Production Environment Variables Template
# Copy this file to .env.production and fill in the actual values

# Server Configuration
NODE_ENV=production
PORT=3001

# API Keys for LLM Providers
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_needed
QDRANT_COLLECTION_NAME=wiki_documents

# Optional: PostgreSQL for session storage
DATABASE_URL=postgresql://user:password@localhost:5432/wiki_db

# CORS Configuration
ALLOWED_ORIGINS=https://wiki.camthink.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Document Reindexing
ENABLE_AUTO_REINDEX=false
REINDEX_CRON=*/30 * * * *

# Security
SESSION_SECRET=your_random_session_secret_here
IP_SALT=change-me-in-production-use-a-random-32-char-string
