# Environment Variables Template
# Copy this file to .env and fill in the actual values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# LLM Provider Configuration
# Primary LLM (Zhipu GLM - Main Model, Free)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

# Fallback LLM 1 (SiliconFlow - Backup)
# 使用 DeepSeek-R1-Distill-Qwen-7B 模型（推理能力强）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Fallback LLM 2 (DeepSeek - Cost-effective)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fallback LLM 3 (Alibaba Qwen - High Quality)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Embedding Model Configuration
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Zhipu Embedding-3 Configuration (Secondary Provider)
# 并发调用，提升索引速度和容错能力
ZHIPU_EMBEDDING_ENABLED=true
ZHIPU_EMBEDDING_API_KEY=your_zhipu_api_key_here
ZHIPU_EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSION=1024

# Reranker Configuration
# 性能优化: 条件性启用Reranker (PRD §9.3)
# 快速路径(置信度≥0.7): 跳过Reranker以减少~1s延迟
# 智能路径(置信度<0.7): 启用Reranker以保证质量
# 设置为false可全局禁用Reranker
RERANKER_ENABLED=true
RERANKER_PROVIDER=siliconflow
RERANKER_API_KEY=your_siliconflow_api_key_here
RERANKER_API_BASE=https://api.siliconflow.cn/v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector Store Configuration
# For Qdrant (when using external vector database)
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=wiki_docs

# For SQLite with persistent vector storage (default for MVP)
# Vector embeddings are stored in the same SQLite database as chat data
VECTOR_STORE_TYPE=sqlite
VECTOR_DB_PATH=./data/chat.db

# Database Configuration
DATABASE_PATH=./data/chat.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Agent Configuration
AGENT_FAST_PATH_THRESHOLD=0.7
AGENT_MAX_RETRIEVAL_STEPS=3
AGENT_TIMEOUT_MS=15000

# Think Mode Configuration
AGENT_THINK_MODE=true
AGENT_THINK_MODE_LANGUAGE_AGNOSTIC=true
AGENT_THINK_MODE_MAX_TOKENS=500

# Langfuse Observability (Optional)
# Get keys from https://cloud.langfuse.com or self-hosted instance
# Leave empty to disable Langfuse tracking
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
