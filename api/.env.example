# Environment Variables Template
# Copy this file to .env and fill in the actual values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# LLM Provider Configuration
# Primary LLM (DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fallback LLM 1 (Zhipu GLM)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# Fallback LLM 2 (Alibaba Qwen) - Optional
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Embedding Model Configuration
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Vector Store Configuration
# For Qdrant (when using external vector database)
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=wiki_docs

# For SQLite with persistent vector storage (default for MVP)
# Vector embeddings are stored in the same SQLite database as chat data
VECTOR_STORE_TYPE=sqlite
VECTOR_DB_PATH=./data/chat.db

# Database Configuration
DATABASE_PATH=./data/chat.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Agent Configuration
AGENT_FAST_PATH_THRESHOLD=0.7
AGENT_MAX_RETRIEVAL_STEPS=3
AGENT_TIMEOUT_MS=15000

# Think Mode Configuration
AGENT_THINK_MODE=true
AGENT_THINK_MODE_LANGUAGE_AGNOSTIC=true
AGENT_THINK_MODE_MAX_TOKENS=500

# Langfuse Observability (Optional)
# Get keys from https://cloud.langfuse.com or self-hosted instance
# Leave empty to disable Langfuse tracking
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
