          "expr": "sum by (path) (wiki_api_askai_path_selection_total)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "title": "路径选择分布",
      "type": "piechart"
    },
    {
      "datasource": {
