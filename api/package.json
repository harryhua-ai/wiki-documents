{
  "name": "@camthink/wiki-api",
  "version": "1.0.0",
  "description": "Backend API service for CamThink Wiki Ask AI feature",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "tsx src/lib/migrate.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "init-db": "tsx scripts/init-simple-db.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "ingest:en": "tsx src/scripts/ingest.ts --language=en",
    "ingest:zh": "tsx src/scripts/ingest.ts --language=zh-Hans",
    "ingest:dry": "tsx src/scripts/ingest.ts --dry-run",
    "ingest:force": "tsx src/scripts/ingest.ts --force"
  },
  "keywords": [
    "api",
    "rag",
    "llm",
    "wiki"
  ],
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.16.2",
    "better-sqlite3": "^9.6.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "gray-matter": "^4.0.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "langfuse": "^3.38.6",
    "lru-cache": "^11.2.6",
    "mdast-util-to-string": "^4.0.0",
    "openai": "^4.26.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.4",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@jest/transform": "^30.2.0",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/mdast": "^4.0.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.18"
  }
}
