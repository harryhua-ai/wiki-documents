# 测试环境变量
NODE_ENV=test
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# LLM Provider Configuration
ZHIPU_API_KEY=test-zhipu-key
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

SILICONFLOW_API_KEY=test-siliconflow-key
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

DEEPSEEK_API_KEY=test-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=test-qwen-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Embedding Model Configuration
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=test-embedding-key
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Zhipu Embedding-3 Configuration (Secondary Provider)
ZHIPU_EMBEDDING_ENABLED=true
ZHIPU_EMBEDDING_API_KEY=test-zhipu-embedding-key
ZHIPU_EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSION=1024

# Reranker Configuration
RERANKER_ENABLED=true
RERANKER_PROVIDER=siliconflow
RERANKER_API_KEY=test-reranker-key
RERANKER_API_BASE=https://api.siliconflow.cn/v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector Store Configuration
VECTOR_STORE_TYPE=sqlite
DATABASE_PATH=./data/test-chat.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Agent Configuration
AGENT_FAST_PATH_THRESHOLD=0.7
AGENT_MAX_RETRIEVAL_STEPS=3
AGENT_TIMEOUT_MS=15000

# Think Mode Configuration
AGENT_THINK_MODE=true
AGENT_THINK_MODE_LANGUAGE_AGNOSTIC=true
AGENT_THINK_MODE_MAX_TOKENS=500

# Security
IP_SALT=test-salt-for-testing

# Langfuse (empty for tests)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
